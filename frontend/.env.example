# 프론트(Vite)에서 사용하는 환경변수입니다. 복사해서 frontend/.env 로 사용하세요.
# 브라우저에 그대로 노출되므로 VITE_* 변수에는 절대 비밀값(SUPABASE_SERVICE_KEY 등)을 넣지 마세요.

# 백엔드(FastAPI) 주소. 비우면 http://127.0.0.1:8000 을 사용합니다.
VITE_API_BASE_URL=http://127.0.0.1:8000

# 검색 1번당 자동으로 분석할 영상 수 (0~5, 기본 5). 나머지는 카드를 눌렀을 때만 분석합니다.
# YouTube 다운로드 제한을 피하려고 작게 유지하세요.
VITE_AUTO_ANALYZE_COUNT=5
