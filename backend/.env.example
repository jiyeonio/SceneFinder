# 필수
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
YOUTUBE_API_KEY=

# AI 사용 여부: 1이면 실제 모델, 0이면 가짜 결과(stub)로 동작
USE_REAL_AI=1

# 한국어 자막 검색용 MiniLM(final_model) 폴더의 절대 경로
SCENEFINDER_MINILM_MODEL_PATH=

# 선택
# 프론트 주소 허용 목록 (쉼표로 구분). 비워 두면 기본값: localhost/127.0.0.1의 3000, 5173
# 프론트(vite)는 기본으로 3000 포트에서 실행됩니다.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# 선택: 검색어 번역 모델 (기본 NLLB 2.4GB, 가벼운 모델은 Helsinki-NLP/opus-mt-ko-en)
TRANSLATE_MODEL=facebook/nllb-200-distilled-600M
# 선택: 자막 생성(Whisper) 모델. 기본 large-v3-turbo (처음 실행 때 약 1.6GB 내려받음, GPU 메모리 약 2.4GB).
# GPU 메모리가 부족하면 small (약 1.2GB, 자막 검색 정확도는 낮음). 근거: docs/experiments/whisper_turbo_switch.md
WHISPER_MODEL_SIZE=large-v3-turbo
# 선택: 자막 구간 보정 (시작 앞당김 초, 최소 길이 초)
SUBTITLE_PAD_BEFORE=2.0
SUBTITLE_MIN_LEN=6.0
# 선택: 로컬 파일 분석(POST .../analyze-local)에서 path로 허용할 폴더 (여러 개는 ':'로 구분)
LOCAL_VIDEO_DIRS=~/scenefinder_eval/videos
# 선택: YouTube가 다운로드를 막아 실패한 영상을 다시 받지 않는 시간(분). 0이면 끔
DOWNLOAD_BLOCK_COOLDOWN_MIN=10
